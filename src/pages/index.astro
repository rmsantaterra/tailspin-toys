---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const slugify = (value: string) =>
    value
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');

const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const games = await getAllGames(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 rounded-xl border border-slate-700 bg-slate-800/50 p-5 shadow-lg" data-testid="game-filters">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <h2 class="text-xl font-medium text-slate-100">Filter games</h2>
        <button
          type="button"
          class="inline-flex items-center justify-center rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          data-testid="clear-filters"
        >
          Clear filters
        </button>
      </div>

      <div class="mt-5 grid gap-5 md:grid-cols-2">
        <fieldset class="rounded-xl border border-slate-700 bg-slate-900/40 p-4">
          <legend class="px-2 text-sm font-medium uppercase tracking-wide text-slate-300">Categories</legend>
          <div class="mt-3 flex flex-wrap gap-3">
            {categories.map((category) => (
              <label
                class="inline-flex items-center gap-2 rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-sm text-slate-200 transition-colors hover:bg-slate-700 focus-within:ring-2 focus-within:ring-blue-500"
                data-testid={`category-filter-label-${slugify(category.name)}`}
              >
                <input
                  type="checkbox"
                  value={String(category.id)}
                  data-filter-group="category"
                  data-testid={`category-filter-${slugify(category.name)}`}
                  aria-label={`Filter by ${category.name}`}
                  class="h-4 w-4 rounded border-slate-600 bg-slate-800 text-blue-500 focus:ring-blue-500"
                />
                <span>{category.name}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="rounded-xl border border-slate-700 bg-slate-900/40 p-4">
          <legend class="px-2 text-sm font-medium uppercase tracking-wide text-slate-300">Publishers</legend>
          <div class="mt-3 flex flex-wrap gap-3">
            {publishers.map((publisher) => (
              <label
                class="inline-flex items-center gap-2 rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-sm text-slate-200 transition-colors hover:bg-slate-700 focus-within:ring-2 focus-within:ring-blue-500"
                data-testid={`publisher-filter-label-${slugify(publisher.name)}`}
              >
                <input
                  type="checkbox"
                  value={String(publisher.id)}
                  data-filter-group="publisher"
                  data-testid={`publisher-filter-${slugify(publisher.name)}`}
                  aria-label={`Filter by ${publisher.name}`}
                  class="h-4 w-4 rounded border-slate-600 bg-slate-800 text-blue-500 focus:ring-blue-500"
                />
                <span>{publisher.name}</span>
              </label>
            ))}
          </div>
        </fieldset>
      </div>
    </div>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div data-testid="filter-empty-state" hidden aria-live="polite" class="mt-6">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>

  <script is:inline>
    const categoryFilters = Array.from(document.querySelectorAll('[data-filter-group="category"]'));
    const publisherFilters = Array.from(document.querySelectorAll('[data-filter-group="publisher"]'));
    const gameCards = Array.from(document.querySelectorAll('[data-testid="game-card"]'));
    const emptyState = document.querySelector('[data-testid="filter-empty-state"]');
    const clearFiltersButton = document.querySelector('[data-testid="clear-filters"]');

    const selectedValues = (filters) =>
      filters
        .filter((input) => input.checked)
        .map((input) => input.value);

    const applyFilters = () => {
      const selectedCategories = selectedValues(categoryFilters);
      const selectedPublishers = selectedValues(publisherFilters);
      let visibleGames = 0;

      gameCards.forEach((card) => {
        const matchesCategory = selectedCategories.length === 0 || selectedCategories.includes(card.dataset.categoryId || '');
        const matchesPublisher = selectedPublishers.length === 0 || selectedPublishers.includes(card.dataset.publisherId || '');
        const isVisible = matchesCategory && matchesPublisher;

        card.hidden = !isVisible;
        card.setAttribute('aria-hidden', String(!isVisible));

        if (isVisible) {
          visibleGames += 1;
        }
      });

      if (emptyState) {
        emptyState.hidden = visibleGames > 0;
      }
    };

    [...categoryFilters, ...publisherFilters].forEach((input) => {
      input.addEventListener('change', applyFilters);
    });

    clearFiltersButton?.addEventListener('click', () => {
      categoryFilters.forEach((input) => {
        input.checked = false;
      });
      publisherFilters.forEach((input) => {
        input.checked = false;
      });
      applyFilters();
    });

    applyFilters();
  </script>
</Layout>
